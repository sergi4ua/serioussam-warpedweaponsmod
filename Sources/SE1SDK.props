<?xml version="1.0" encoding="utf-8"?>
<!-- Shared settings for building Serious Sam: The Second Encounter 1.07 modules
     with a modern MSVC toolset against the 1.07 headers/libraries shipped in
     ThirdParty\SE1-ModSDK (https://github.com/DreamyCecil/SE1-ModSDK). -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <!-- Extension appended by the engine to the names of mod libraries (Mods\<mod>\ModEXT.txt):
         Entities<ext>.dll, Game<ext>.dll and GameGUI<ext>.dll -->
    <ModExt>WW</ModExt>

    <SE1SdkDir>$(MSBuildThisFileDirectory)..\ThirdParty\SE1-ModSDK\Sources\</SE1SdkDir>
    <SE1Ecc>$(SE1SdkDir)Includes\Ecc.exe</SE1Ecc>
    <SE1EngineIncludes>$(SE1SdkDir)Includes\Engine107;$(SE1SdkDir)Includes\Common;$(SE1SdkDir)Includes\CommonModels</SE1EngineIncludes>
    <SE1EngineLibraries>$(SE1SdkDir)Includes\Engine107</SE1EngineLibraries>

    <SE1Games>SS_TFE='F';SS_TSE='S';SS_XBX='X';SS_150='B';SS_REV='R';SS_EVA='A';SE_ABZ='a';SE_BH3='b';SE_CCS='c';SE_DH3='d';SE_EC='e';SE_LC='l';SE_NF='n';SE_RK='r'</SE1Games>
    <SE1Versions>SE1_EVA=1;SE1_PB1=10;SE1_PB2=20;SE1_PB21=21;SE1_100=100;SE1_102=102;SE1_104=104;SE1_105=105;SE1_107=107;SE1_110=110;SE1_150=150</SE1Versions>
    <SE1Preproc>$(SE1Games);$(SE1Versions);SE1_VER=SE1_107;SE1_GAME=SS_TSE;SE1_D3D;DIRECT3D_VERSION=0x0800;WIN32;_WINDOWS;_WINDLL;_USRDLL;_USE_32BIT_TIME_T;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS</SE1Preproc>

    <!-- The 1.07 sources were written for MSVC 6.0. -->
    <SE1CompilerOptions>/Zc:forScope- /Zc:strictStrings- /Zc:threadSafeInit- /Zc:sizedDealloc-</SE1CompilerOptions>
    <SE1DisabledWarnings>4018;4065;4101;4102;4244;4267;4305;4309;4311;4312;4333;4477;4800;4838;4996;5208</SE1DisabledWarnings>
  </PropertyGroup>
</Project>
