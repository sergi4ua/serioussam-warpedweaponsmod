<?xml version="1.0" encoding="utf-8"?>
<!-- Advanced HUD plugin of Serious Sam Classics Patch 1.9.4 (Extensions\AdvancedHUD) with the
     Warped Weapons Plasmathrower and Minelayer added; changes are marked with "[WW]". -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32"><Configuration>Debug</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{3A9F6C21-8E4B-4D7A-B2C5-1E0F9D8A7B64}</ProjectGuid>
    <RootNamespace>AdvancedHUD</RootNamespace>
    <ProjectName>AdvancedHUD</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset Condition="'$(PlatformToolset)'==''">v145</PlatformToolset>
    <CharacterSet>NotSet</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="..\..\SE1SDK.props" />
  </ImportGroup>
  <PropertyGroup>
    <CPDir>$(SolutionDir)ThirdParty\ClassicsPatch\</CPDir>
    <TargetName>AdvancedHUD</TargetName>
    <OutDir>$(SolutionDir)Build\$(Configuration)\ClassicsPatch\Plugins\</OutDir>
    <IntDir>$(SolutionDir)Build\Obj\$(Configuration)\$(ProjectName)\</IntDir>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir);$(CPDir);$(CPDir)CustomMod;$(SE1EngineIncludes);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>$(SE1Preproc);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>StdH.h</PrecompiledHeaderFile>
      <WarningLevel>Level3</WarningLevel>
      <DisableSpecificWarnings>$(SE1DisabledWarnings);%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <AdditionalOptions>$(SE1CompilerOptions) %(AdditionalOptions)</AdditionalOptions>
      <ConformanceMode>false</ConformanceMode>
      <EnableEnhancedInstructionSet>NoExtensions</EnableEnhancedInstructionSet>
      <FloatingPointModel>Precise</FloatingPointModel>
      <ExceptionHandling>Sync</ExceptionHandling>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalLibraryDirectories>$(SE1EngineLibraries);$(IntDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>Engine.lib;ClassicsCore.lib;Ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <GenerateMapFile>true</GenerateMapFile>
      <ImageHasSafeExceptionHandlers>false</ImageHasSafeExceptionHandlers>
    </Link>
    <PreBuildEvent>
      <Message>Import library for ClassicsCore.dll</Message>
      <Command>lib.exe /nologo /machine:x86 /def:"$(ProjectDir)..\ClassicsCore.def" /out:"$(IntDir)ClassicsCore.lib"</Command>
    </PreBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>OnlyExplicitInline</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <StringPooling>true</StringPooling>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="StdH.cpp"><PrecompiledHeader>Create</PrecompiledHeader></ClCompile>
    <ClCompile Include="Elements.cpp" />
    <ClCompile Include="HUD.cpp" />
    <ClCompile Include="HUDParts.cpp" />
    <ClCompile Include="Main.cpp" />
    <ClCompile Include="Themes.cpp" />
    <ClCompile Include="..\..\EntitiesMP\Compat\HeapCompat.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="HUD.h" />
    <ClInclude Include="StdH.h" />
    <ClInclude Include="Themes.h" />
    <ClInclude Include="WeaponArsenal.h" />
    <None Include="Colors.inl" />
    <None Include="Sorting.inl" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
